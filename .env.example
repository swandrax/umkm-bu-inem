# ===================================================================
# Jajanan Ibu Inem POS - Backend Environment Configuration
# ===================================================================

# Database Connection (MySQL Default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jajanan_ibu_inem
DB_USERNAME=app_user
DB_PASSWORD=GANTI_DENGAN_SECRET_DATABASE

# JWT Security
# Buat secret acak (minimal 32 byte), jangan commit nilai sebenarnya.
JWT_SECRET=GANTI_DENGAN_SECRET_JWT_MIN_32_BYTE
JWT_EXPIRATION=900000

# Server Port
PORT=8080

# CORS Allowed Origin
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Xendit (backend only; gunakan API key test saat local development)
XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_VERSION=2024-11-11
# URL yang dapat dijangkau Xendit, harus HTTPS pada test/live webhook.
XENDIT_SUCCESS_RETURN_URL=http://localhost/payment/success
XENDIT_FAILURE_RETURN_URL=http://localhost/payment/failed

# HUMAN Bot Defender / PerimeterX — hanya secret manager server/edge
PX_APP_ID=
PX_AUTH_TOKEN=
PX_COOKIE_SECRET=
PX_ENABLED=false
PX_BLOCK_ENABLED=false
